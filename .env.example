# Revora-Backend environment variables — example configuration.
#
# Copy this file to `.env` for local development or set these variables
# in your execution environment / secret manager for staging & production.
#
# BOOLEAN FLAGS
# -------------
# All boolean flags accept the same explicit value set (case-insensitive,
# surrounding whitespace ignored):
#
#   enabled:  true, 1, yes, on
#   disabled: false, 0, no, off
#
# Anything else — including an empty string — fails startup with a
# configuration validation error, e.g.:
#   [FATAL] Configuration validation failed: ... EMAIL_DELIVERABILITY_ENABLED:
#           must be one of: true, false, 1, 0, yes, no, on, off (case-insensitive)
#
# Do NOT use `z.coerce.boolean()` semantics as a reference: `Boolean("false")`
# is `true` in JavaScript, which previously made it impossible to disable
# these features (issue #1305). To use a flag's default value, leave the
# variable UNSET rather than setting it to an empty string.

# ==============================================================================
# 1. SERVER & RUNTIME ENVIRONMENT
# ==============================================================================

# Application environment: development | test | production. Default: development.
NODE_ENV=development

# Process role when running in split worker topologies: api | batch | all. Optional.
ROLE=all

# HTTP listening port for Express server. Default: 4000.
PORT=4000

# Base URL prefix mounted for all API routes. Default: /api/v1.
API_VERSION_PREFIX=/api/v1

# Public application base URLs (used for OAuth redirects and canonical links).
APP_BASE_URL=http://localhost:4000
APP_URL=http://localhost:4000

# Hostname or container instance identifier. Optional.
HOSTNAME=revora-dev-1

# Logging level: debug | info | warn | error. Default: info.
LOG_LEVEL=info

# Graceful shutdown timeout in milliseconds before forcing process termination. Default: 10000.
SHUTDOWN_TIMEOUT_MS=10000

# OpenTelemetry / Jaeger collector endpoint URL for distributed tracing. Optional.
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Bearer token required to scrape the /metrics endpoint. Optional in dev.
METRICS_TOKEN=dev-metrics-token-placeholder

# ==============================================================================
# 2. DATABASE & REPLICAS (PostgreSQL)
# ==============================================================================

# PostgreSQL primary connection URL. Required in production.
# Format: postgresql://[user[:password]@][host][:port][/dbname][?sslmode=...]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revora_dev

# Optional read-replica URLs for routing read-only queries.
DATABASE_READ_URL=postgresql://postgres:postgres@localhost:5433/revora_dev_read
REPLICA_DB_URL=postgresql://postgres:postgres@localhost:5433/revora_dev_read

# Read replica replication lag threshold in milliseconds before failing over to primary. Default: 5000.
REPLICA_LAG_THRESHOLD_MS=5000

# Polling interval in milliseconds for replica health check and lag evaluation. Default: 10000.
REPLICA_POLL_INTERVAL_MS=10000

# PostgreSQL SSL connection mode: disable | require | verify-ca | verify-full. Default: disable in dev.
PGSSLMODE=disable

# Granular database credentials (used if DATABASE_URL is not set directly). Optional.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=revora_dev

# Shared Redis connection URL for distributed locks, caching, and rate limiting. Optional.
REDIS_URL=redis://localhost:6379

# ==============================================================================
# 3. AUTHENTICATION & JWT TOKENS
# ==============================================================================

# Primary HMAC secret key for signing JSON Web Tokens.
# Required in production (minimum 16 characters, 32+ recommended).
JWT_SECRET=dev-jwt-secret-placeholder-minimum-32-chars-long!

# Previous JWT secret key used to verify tokens during graceful rotation window. Optional.
JWT_SECRET_PREVIOUS=previous-jwt-secret-placeholder-for-rotation!

# Key ID (kid) associated with the active JWT_SECRET. Optional.
JWT_KEY_ID=revora-key-2026-v1

# Key ID (kid) associated with JWT_SECRET_PREVIOUS. Optional.
JWT_PREVIOUS_KEY_ID=revora-key-2025-v1

# Expected JWT issuer claim (iss). Optional.
JWT_ISSUER=https://api.revora.com

# Expected JWT audience claim (aud). Optional.
JWT_AUDIENCE=revora-clients

# Clock drift tolerance in seconds for token verification (exp/nbf). Optional (e.g. 30).
JWT_CLOCK_TOLERANCE_SECONDS=30

# Retention period in days for expired or revoked session records. Default: 30.
SESSION_RETENTION_DAYS=30

# ==============================================================================
# 4. ADMIN & CRYPTOGRAPHIC SIGNING KEYS
# ==============================================================================

# JSON map of authorized admin key identifiers to public keys for admin endpoints.
# Example: {"admin-1":"<hex-or-base64-pubkey>","admin-2":"<hex-or-base64-pubkey>"}
ADMIN_PUBKEYS={"admin-dev":"dev-admin-public-key-placeholder"}

# Comma-separated list of authorized Ed25519 admin public keys (hex/base64). Optional.
ADMIN_ED25519_PUBKEYS=dev-admin-ed25519-public-key-placeholder

# Treasury Ed25519 public key (hex/base64) for verifying treasury authorization signatures. Optional.
TREASURY_ED25519_PUBKEY=dev-treasury-ed25519-public-key-placeholder

# Secret key for HMAC-signed opaque pagination cursors. Minimum 16 characters.
CURSOR_SIGNING_SECRET=dev-cursor-signing-secret-placeholder-min-16-chars

# Secret key for HMAC signature verification against replay attacks. Optional.
REPLAY_SIGNING_SECRET=dev-replay-signing-secret-placeholder

# Secret key for HMAC-signed SLA compliance report exports. Optional.
SLA_REPORT_SIGNING_SECRET=dev-sla-report-signing-secret-placeholder

# Secret key for HMAC-signed startup rate-limiter tier policy verification. Optional.
STARTUP_AUTH_TIER_SECRET=dev-startup-auth-tier-secret-placeholder

# ==============================================================================
# 5. STELLAR NETWORK & SOROBAN RPC
# ==============================================================================

# Target Stellar network: testnet | public. Default: testnet.
STELLAR_NETWORK=testnet

# Secret key (seed starting with 'S') of the server's signing account.
# Required outside test environments.
STELLAR_SERVER_SECRET=SBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Primary Horizon REST server URL. Default: network default Horizon URL.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Comma-separated list of Horizon URLs for high-availability failover. Optional.
STELLAR_HORIZON_URLS=https://horizon-testnet.stellar.org,https://horizon-testnet-backup.stellar.org

# Stellar network passphrase (overrides network default when using standalone networks). Optional.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Soroban RPC server endpoint URL. Optional.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Timeout in milliseconds for Stellar Horizon/RPC network operations. Default: 30000.
STELLAR_TIMEOUT=30000

# Maximum transaction submission fee in stroops (1 XLM = 10,000,000 stroops). Default: 100000.
STELLAR_MAX_FEE=100000

# Starting ledger sequence number for ingestion and reconciliation catchup. Optional.
STARTLEDGER=1
START_LEDGER=1

# ==============================================================================
# 6. LEDGER PERIOD CLOSE SIGNING
# ==============================================================================

# Server-held 64-character hex-encoded private key for signing ledger period closes.
# Required when ledger export signing is enabled. (Never store in database).
LEDGER_CLOSE_SIGNING_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Version number of the active LEDGER_CLOSE_SIGNING_KEY. Default: 1.
LEDGER_CLOSE_SIGNING_KEY_VERSION=1

# ==============================================================================
# 7. AUDIT LOGGING & COMPLIANCE EXPORTS
# ==============================================================================

# Retention period in days for audit trail records. Default: 90.
AUDIT_RETENTION_DAYS=90

# Base64-encoded Ed25519 private key seed (32 bytes) for signing tamper-evident audit CSV exports.
# Required in production.
AUDIT_EXPORT_SIGNING_KEY=dGVzdC1hdWRpdC1leHBvcnQtc2lnbmluZy1rZXktc2VlZC0zMmJ5dGVzCg==

# Base64-encoded Ed25519 public key corresponding to AUDIT_EXPORT_SIGNING_KEY.
# Documented so external auditors can verify export integrity offline. Optional.
AUDIT_EXPORT_PUBLIC_KEY=dGVzdC1hdWRpdC1leHBvcnQtcHVibGljLWtleS0zMmJ5dGVzCg==

# HTTPS endpoint of the Rekor transparency log used to publish audit hash-chain roots.
# Leave unset to use the in-process mock witness (development/test only).
# Example: WITNESS_REKOR_URL=https://rekor.sigstore.dev
# WITNESS_REKOR_URL=

# ==============================================================================
# 8. CORS & NETWORKING
# ==============================================================================

# Comma-separated list of allowed CORS origins. Default in dev: http://localhost:3000.
ALLOWED_ORIGINS=http://localhost:3000,https://app.revora.com

# Allow CORS requests that carry no Origin header (curl, health checks, internal microservices).
# Accepts: true, false, 1, 0, yes, no, on, off. Default: false.
CORS_ALLOW_NO_ORIGIN=false

# Expected inbound public IP address for edge proxy validation. Optional.
EXPECTED_IP=127.0.0.1

# ==============================================================================
# 9. EMAIL & DELIVERABILITY
# ==============================================================================

# Active email delivery provider: sendgrid | smtp | mock.
# Note: mock provider is prohibited in production.
EMAIL_PROVIDER=mock

# Default sender email address for outgoing transactional emails. Optional.
FROM_EMAIL=noreply@revora.com

# SendGrid API key. Required when EMAIL_PROVIDER=sendgrid.
SENDGRID_API_KEY=SG.placeholder_api_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret for verifying incoming SendGrid Event Webhook signatures. Optional.
SENDGRID_EVENT_WEBHOOK_SECRET=placeholder-sendgrid-webhook-verification-secret

# SMTP relay host. Required when EMAIL_PROVIDER=smtp.
SMTP_HOST=smtp.sendgrid.net

# SMTP relay port. Default: 587.
SMTP_PORT=587

# SMTP authentication username. If provided, SMTP_PASS must also be provided.
SMTP_USER=apikey

# SMTP authentication password. If provided, SMTP_USER must also be provided.
SMTP_PASS=placeholder-smtp-password

# Enable email deliverability tracking and bounce webhook endpoints.
# Accepts: true, false, 1, 0, yes, no, on, off. Default: true.
EMAIL_DELIVERABILITY_ENABLED=true

# AWS SNS Topic ARN for SES bounce notifications. Optional.
SES_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:ses-bounces-topic

# Days before auto-suppressed bounced email addresses expire. Default: 365.
SUPPRESSION_AUTO_EXPIRE_DAYS=365

# Threshold ratio (e.g. 0.05 = 5%) for bounce alarms. Default: 0.05.
BOUNCE_RATIO_ALARM_THRESHOLD=0.05

# ==============================================================================
# 10. TRANSACTIONAL OUTBOX & WEBHOOKS
# ==============================================================================

# Start the background transactional outbox dispatcher worker.
# Accepts: true, false, 1, 0, yes, no, on, off. Default: false.
OUTBOX_DISPATCHER_ENABLED=false

# Maximum queue depth for outbound webhook dispatching before applying backpressure. Default: 100.
WEBHOOK_QUEUE_MAX_DEPTH=100

# Shared HMAC secret key for signing outgoing webhook payloads. Optional.
WEBHOOK_SECRET=dev-outgoing-webhook-secret-placeholder

# ==============================================================================
# 11. KYC & AML COMPLIANCE
# ==============================================================================

# Consecutive failures before the KYC provider circuit breaker trips open. Default: 3.
KYC_CIRCUIT_TRIP_ERRORS=3

# Time-to-live in milliseconds for cached KYC decisions. Default: 300000 (5 minutes).
KYC_CIRCUIT_CACHE_TTL_MS=300000

# Wait duration in milliseconds before moving the KYC circuit breaker to half-open. Default: 30000.
KYC_CIRCUIT_HALF_OPEN_MS=30000

# HMAC secret key for verifying incoming KYC vendor webhook payloads. Optional.
KYC_WEBHOOK_SECRET=dev-kyc-webhook-secret-placeholder
KYC_WEBHOOK_KEY=dev-kyc-webhook-key-placeholder

# Next HMAC key for rotating KYC webhook secrets. Optional.
KYC_WEBHOOK_KEY_NEXT=dev-kyc-webhook-key-next-placeholder

# Unix timestamp (in seconds or ms) when KYC_WEBHOOK_KEY_NEXT becomes mandatory. Optional.
KYC_WEBHOOK_KEY_NEXT_EXPIRY=1767225600

# Record live AML/KYC provider HTTP fixtures instead of replaying recorded ones.
# Accepts: true, false, 1, 0, yes, no, on, off. Development only. Default: false.
RECORD_FIXTURES=false

# Active provider version identifier for KYC routing. Optional.
PROVIDER_VERSION=1.0.0

# URL to fetch the OFAC Specially Designated Nationals (SDN) CSV list. Optional.
OFAC_LIST_URL=https://www.treasury.gov/ofac/downloads/sdn.csv

# URL to fetch the detached Ed25519 signature for the OFAC SDN list. Optional.
OFAC_SIG_URL=https://www.treasury.gov/ofac/downloads/sdn.csv.sig

# Base64-encoded Ed25519 public key used to verify the OFAC list signature. Optional.
OFAC_TRUST_ANCHOR_BASE64=dGVzdC1vZmFjLXRydXN0LWFuY2hvci1wdWJsaWMta2V5LTMyeX==

# Timeout in milliseconds when fetching OFAC lists. Default: 30000.
OFAC_FETCH_TIMEOUT_MS=30000

# Bearer token for SCIM 2.0 enterprise user provisioning API. Optional.
SCIM_TOKEN=dev-scim-bearer-token-placeholder

# ==============================================================================
# 12. MULTI-REGION, FAILOVER & HIGH AVAILABILITY
# ==============================================================================

# Identifier for the current deployment region. Default: us-east-1.
REGION=us-east-1

# Region currently designated as the active failover target. Optional.
FAILOVER_ACTIVE_REGION=us-east-1

# Health check endpoints for cross-region monitoring.
HEALTH_URL=http://localhost:4000/health
PRIMARY_HEALTH_URL=https://us-east-1.api.revora.com/health
SECONDARY_HEALTH_URL=https://us-west-2.api.revora.com/health

# Health check replication lag threshold in milliseconds. Optional.
HEALTH_LAG_THRESHOLD=5000

# DNS failover configuration.
TARGET_TTL=60
PRIMARY_DNS=8.8.8.8

# Background reconciliation interval in milliseconds. Default: 60000.
RECONCILIATION_INTERVAL_MS=60000

# Maximum number of missed scheduler intervals to catch up. Default: 10.
SCHEDULER_CATCHUP_MAX=10

# ==============================================================================
# 13. HOLIDAY CALENDAR CONFIGURATION
# ==============================================================================

# Local filesystem path to the banking holiday calendar definition file. Optional.
HOLIDAY_CALENDAR_FILE_PATH=./config/holidays-2026.json

# HMAC secret key used to verify the integrity of the holiday calendar file. Optional.
HOLIDAY_CALENDAR_SECRET=dev-holiday-calendar-secret-placeholder

# Business day fallback policy when a settlement lands on a holiday: previous | next. Default: previous.
HOLIDAY_FALLBACK_SHIFT_POLICY=previous

# ==============================================================================
# 14. OAUTH & IDENTITY PROVIDERS (OIDC)
# ==============================================================================

# Google OAuth 2.0 Client ID for social login. Optional.
GOOGLE_CLIENT_ID=placeholder-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=placeholder-google-client-id.apps.googleusercontent.com

# Apple Sign-In Service / Client ID. Optional.
APPLE_CLIENT_ID=com.revora.app.signin
APPLE_SERVICE_ID=com.revora.app.signin

# Time-to-live in milliseconds for caching OIDC provider discovery metadata. Default: 86400000 (24h).
OIDC_DISCOVERY_TTL_MS=86400000
