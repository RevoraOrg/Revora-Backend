# Revora-Backend environment variables — example configuration.
#
# BOOLEAN FLAGS
# -------------
# All boolean flags accept the same explicit value set (case-insensitive,
# surrounding whitespace ignored):
#
#   enabled:  true, 1, yes, on
#   disabled: false, 0, no, off
#
# Anything else — including an empty string — fails startup with a
# configuration validation error, e.g.:
#   [FATAL] Configuration validation failed: ... EMAIL_DELIVERABILITY_ENABLED:
#           must be one of: true, false, 1, 0, yes, no, on, off (case-insensitive)
#
# Do NOT use `z.coerce.boolean()` semantics as a reference: `Boolean("false")`
# is `true` in JavaScript, which previously made it impossible to disable
# these features (issue #1305). To use a flag's default value, leave the
# variable UNSET rather than setting it to an empty string.

# Enable email deliverability tracking and mount the bounce webhook routes
# (/api/v1/email/webhooks/{sendgrid,ses,smtp}). Default: true.
EMAIL_DELIVERABILITY_ENABLED=true

# Start the transactional outbox dispatcher worker (see
# docs/transactional-outbox.md). Default: false.
OUTBOX_DISPATCHER_ENABLED=false

# Allow CORS requests that carry no Origin header (curl, health checks,
# internal services). Default: false. See docs/cors-allowlist.md.
CORS_ALLOW_NO_ORIGIN=false

# Record live AML/KYC provider fixtures instead of replaying committed ones.
# Development/testing only. Default: false.
RECORD_FIXTURES=false
